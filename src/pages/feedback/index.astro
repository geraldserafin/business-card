---
import Base from "../../layouts/Base.astro";
import "../../styles/feedback.css";
---

<Base title="Jak ci smakowała wróżba?" noindex>
  <header class="bar">
  <div class="bar-in">
    <a class="name" href="../">Gerald Serafin</a>
    <a class="btn" id="cv" href="../cv/Gerald_Serafin_CV_PL.pdf" download>Pobierz CV</a>
  </div>
  <div class="progress" aria-hidden="true"><i id="bar"></i></div>
</header>

  <main>
    <form id="form" novalidate>
      <section class="step" data-key="intro">
        <p class="eyebrow">Talent Days</p>
        <h1>Jak ci smakowała wróżba? 🥠</h1>
        <p class="lead">Kilka krótkich pytań, jedno na ekran. Szczere odpowiedzi pomagają mi bardziej niż miłe.</p>
      </section>
  
      <section class="step" data-key="role" hidden>
        <h2>Kim jesteś?</h2>
        <div class="opts">
          <label class="opt"><input type="radio" name="role" value="Rekruter / HR"> Rekruter / HR</label>
          <label class="opt"><input type="radio" name="role" value="Inżynier / osoba techniczna w firmie"> Osoba techniczna w firmie</label>
          <label class="opt"><input type="radio" name="role" value="Manager / osoba decyzyjna"> Manager / osoba decyzyjna</label>
          <label class="opt"><input type="radio" name="role" value="Inne"> Inne</label>
        </div>
      </section>
  
      <section class="step" data-key="impression" hidden>
        <h2>Jakie wrażenie na tobie zrobiłem?</h2>
        <p class="hint">Wystarczą 2–3 słowa.</p>
        <input type="text" name="impression" autocomplete="off" aria-label="Wrażenie">
      </section>
  
      <section class="step" data-key="invite" data-required hidden>
        <h2>Czy zaprosił(a)byś mnie na rozmowę?</h2>
        <div class="opts">
          <label class="opt"><input type="radio" name="invite" value="Tak"> Tak</label>
          <label class="opt"><input type="radio" name="invite" value="Może, ale czegoś mi brakuje"> Może, ale czegoś mi brakuje</label>
          <label class="opt"><input type="radio" name="invite" value="Nie"> Raczej nie</label>
        </div>
      </section>
  
      <section class="step" data-key="reason" hidden>
        <h2 id="why-label"></h2>
        <textarea name="reason" aria-labelledby="why-label"></textarea>
      </section>
  
      <section class="step" data-key="contact" hidden>
        <h2>Chcesz pogadać? Zostaw namiar</h2>
        <p class="hint">Użyję tego tylko, żeby skontaktować się z tobą w sprawie współpracy.</p>
        <div class="field"><label for="name">Imię</label><input type="text" id="name" name="name" autocomplete="given-name"></div>
        <div class="field"><label for="company">Firma</label><input type="text" id="company" name="company" autocomplete="organization"></div>
        <div class="field"><label for="contact">Mail, telefon lub LinkedIn</label><input type="text" id="contact" name="contact" autocomplete="off"></div>
      </section>
  
      <p class="note" id="note" aria-live="polite"></p>
      <div class="nav" id="nav">
        <button type="button" class="btn" id="back">Wstecz</button>
        <button type="button" class="btn" id="skip">Pomiń</button>
        <button type="button" class="btn" id="next">Dalej</button>
      </div>
    </form>
  
    <section id="done" hidden>
      <h2>Dzięki! 🙏</h2>
      <p>Jeśli chcesz pogadać na żywo: <a href="tel:+48530585515">+48 530 585 515</a> albo <a href="mailto:serafingerald@protonmail.com">serafingerald@protonmail.com</a>. A wróżba i tak się spełni 😉</p>
      <a class="btn primary big" id="cv2" href="../cv/Gerald_Serafin_CV_PL.pdf" download>Pobierz CV</a>
    </section>
  </main>
  
  <script>
    import "../../scripts/feedback.js";
  </script>
</Base>
